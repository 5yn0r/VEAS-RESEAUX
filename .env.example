# Keep the dashboard local unless it is protected by a reverse proxy.
HOST=127.0.0.1
PORT=5000
DEBUG=False
SECRET_KEY=replace-with-a-long-random-value

# Authentication (mandatory if HOST is not 127.0.0.1).
# AUTH_USERNAME=admin
# AUTH_PASSWORD_HASH=   # python -m moniwifi.auth
# API_TOKEN=            # for scripts: Authorization: Bearer <token>
# SESSION_COOKIE_SECURE=true   # when served over HTTPS
# ALLOW_UNAUTHENTICATED=false

# Only list origins that are allowed to open a Socket.IO connection.
# CORS_ALLOWED_ORIGINS=https://monitor.example.com

# Capture interface; leave empty to follow the default route.
# NETWORK_INTERFACE=wlan0
INTERFACE_REFRESH_INTERVAL=60
SNIFFER_CHECK_INTERVAL=5

# SQLite history. Empty DB_PATH keeps everything in memory.
DB_PATH=data/wifi_guardian.db
RETENTION_DAYS=30

SCAN_INTERVAL=30
UPDATE_INTERVAL=2
PORT_SCAN_WINDOW=60
PORT_SCAN_THRESHOLD=20
HOST_SWEEP_THRESHOLD=20
ALERT_COOLDOWN=3600
BEACON_MIN_EVENTS=8
BEACON_MAX_JITTER=0.1
# TRUSTED_DHCP_SERVERS=192.168.1.1
# ALLOWED_DNS_SERVERS=192.168.1.1
RISKY_PORTS=21:FTP,23:Telnet,139:NetBIOS,445:SMB,3389:RDP,5900:VNC

# Correlation and baselines
INCIDENT_WINDOW=3600
BASELINE_BUCKET_SECONDS=300
BASELINE_MIN_SAMPLES=72
BASELINE_SIGMA=4
BASELINE_MIN_ANOMALY_MB=50
BASELINE_LEARNING_HOURS=24
BASELINE_QUIET_DESTINATIONS=30

# Notifications (incidents at or above NOTIFY_MIN_SEVERITY: low, medium, high, critical)
NOTIFY_MIN_SEVERITY=high
NOTIFY_MAX_PER_HOUR=20
# NOTIFY_WEBHOOK_URL=https://hooks.example.com/wifi-guardian
# NOTIFY_NTFY_URL=https://ntfy.sh/your-private-topic
# NOTIFY_NTFY_TOKEN=
# NOTIFY_TELEGRAM_TOKEN=
# NOTIFY_TELEGRAM_CHAT_ID=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=wifi-guardian@example.com
# SMTP_STARTTLS=true
# NOTIFY_EMAIL_TO=you@example.com

# SIEM export (see docs/SIEM.md)
# SIEM_SYSLOG_HOST=127.0.0.1
# SIEM_SYSLOG_PORT=514
# SIEM_SYSLOG_PROTOCOL=udp        # udp or tcp
# SIEM_SYSLOG_FORMAT=json         # json (ECS) or cef
# SIEM_JSON_FILE=data/siem/alerts.jsonl
SIEM_JSON_MAX_MB=50
SIEM_JSON_BACKUPS=5
SIEM_MIN_SEVERITY=low
SIEM_INCLUDE_INCIDENTS=true

# Brute force and LLMNR/NBT-NS poisoning
BRUTE_FORCE_THRESHOLD=20
BRUTE_FORCE_WINDOW=60
NAME_POISONING_THRESHOLD=3

# Threat intelligence (all *.txt files in the directory are loaded).
THREAT_INTEL_DIR=data/intel
# Example public feeds (downloaded every THREAT_INTEL_REFRESH_HOURS):
# THREAT_INTEL_FEEDS=https://feodotracker.abuse.ch/downloads/ipblocklist.txt,https://www.spamhaus.org/drop/drop.txt,https://urlhaus.abuse.ch/downloads/hostfile/
THREAT_INTEL_REFRESH_HOURS=24

DEVICE_ACTIVE_TIMEOUT=300
NEW_DEVICE_LEARNING_PERIOD=600
# OUI_FILE=/usr/share/arp-scan/ieee-oui.txt
MAX_ALERTS=100
MAX_HISTORY=5000
MAX_DNS_CACHE=1000
MAX_PACKET_HISTORY=1000
MAX_ACTIVE_FLOWS=20000
MAX_DNS_LOG=2000
LOG_LEVEL=INFO
